# Copy to .env and fill in. Used by docker-compose.
POSTGRES_USER=symptom
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=symptom_checker

# openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public URL the browser will use (your domain). Comma-separate for multiple.
CLIENT_URL=https://symptom.yourdomain.com

# Host port nginx/frontend listens on (put your TLS proxy in front of this)
FRONTEND_PORT=8080

# Optional integrations (leave blank to disable)
APIMEDIC_USERNAME=
APIMEDIC_PASSWORD=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
