PORT=5000
NODE_ENV=development

# JWT — REQUIRED in production. Must be >= 32 chars of high entropy.
# Generate one with:  openssl rand -hex 48
# The server REFUSES TO START in production if this is missing or too short.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# PostgreSQL (users, doctors, appointments)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/symptom_checker

# MongoDB (symptom session logs)
MONGODB_URI=mongodb://localhost:27017/symptom_checker

# --- Diagnosis engine ---
# The differential-diagnosis engine is self-hosted (no key required).
# Optionally attach ApiMedic (priaid) as a secondary comparison source.
# Sign up: https://apimedic.com
APIMEDIC_USERNAME=
APIMEDIC_PASSWORD=
# APIMEDIC_LANGUAGE=en-gb

# --- Hospital lookup across India (ABDM Health Facility Registry) ---
# Sandbox: https://sandbox.abdm.gov.in  (leave empty to disable facility search)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
# ABDM_BASE_URL=https://facilitysbx.abdm.gov.in
# ABDM_SEARCH_PATH=/api/v1/facility/search

# Frontend URL(s) for CORS — comma-separated for multiple origins.
CLIENT_URL=http://localhost:5173
