PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://postgres:123@localhost:5432/symptom_checker

# MongoDB (symptom session logs)
MONGODB_URI=mongodb://localhost:27017/symptom_checker

# Infermedica API (https://developer.infermedica.com)
# Leave empty to use built-in demo mode with mock data
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=
INFERMEDICA_DEV_MODE=true

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
